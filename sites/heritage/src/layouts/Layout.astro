---
import DraftBanner from "@shared/DraftBanner.astro";
import Field from "@shared/Field.astro";
import { mapsUrl, site } from "@shared/site";
import "@shared/placeholder.css";
import "@shared/price-list.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title
  ? `${title} · ${site.name.value} — PREVIEW`
  : `${site.name.value} — PREVIEW`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";
const BrandName = isHome ? "h1" : "p";

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/contact", label: "Contact" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow+Condensed:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <DraftBanner />
    <header class="site-header">
      <a class="brand" href="/">
        <img
          class="brand-flag"
          src="/shop-flag.png"
          alt=""
          width="252"
          height="122"
        />
        <BrandName class="brand-name">
          <span class="brand-all">All American</span>
          <span class="brand-shop">Butcher Shop</span>
        </BrandName>
      </a>
      <nav aria-label="Primary">
        {
          links.map((link) => (
            <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="stars" aria-hidden="true">★ ★ ★ ★ ★</p>
      <p class="faith">{site.faith.value}</p>
      <p>
        <Field field={site.addressLine1}>{site.addressLine1.value}</Field>
        <Field field={site.addressLine2}>{site.addressLine2.value}</Field>
      </p>
      <p>
        <Field field={site.phone}>
          <a href={site.phoneHref.value}>{site.phone.value}</a>
        </Field>
        ·
        <a href={site.facebookUrl.value}>Facebook</a>
        ·
        <a href={mapsUrl(site.mapQuery.value)}>Directions</a>
      </p>
    </footer>
  </body>
</html>

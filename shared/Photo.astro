---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  ratio?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  caption,
  ratio = "4 / 3",
  width,
  height,
} = Astro.props;
---

<figure class="photo">
  <div class="photo-frame" style={`aspect-ratio: ${ratio}`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
    min-width: 0;
  }

  .photo-frame {
    overflow: hidden;
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  figcaption {
    margin-top: 0.55rem;
    font-size: 0.9rem;
    opacity: 0.85;
  }
</style>

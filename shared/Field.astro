---
type FieldValue = {
  value: unknown;
  placeholder: boolean;
  source: string;
};

interface Props {
  field: FieldValue;
  as?: string;
  class?: string;
}

const { field, as: Tag = "span", class: className } = Astro.props;
---

<Tag
  class:list={["field", className, field.placeholder && "is-ph"]}
  title={field.source}
  data-placeholder={field.placeholder ? "true" : "false"}
>
  {field.placeholder && <span class="ph-flag">Placeholder</span>}
  <slot />
</Tag>
